{
  "name": "saferoute-nepal", "private": true, "type": "module",
  "workspaces": ["client", "server"],
  "engines": {"node": ">=24"},
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "collect": "node --env-file-if-exists=.env server/src/collect.ts",
    "test": "node --test server/test/*.test.ts",
    "check": "tsc --noEmit -p server && tsc --noEmit -p client",
    "build": "npm run check && npm run build -w client"
  },
  "devDependencies": {"typescript": "5.9.3", "@types/node": "25.3.0"}
}
